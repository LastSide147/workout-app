# Шаблон файла с данными релизного ключа подписи приложения.
#
# Как использовать:
# 1. Сгенерируйте свой ключ командой из RUSTORE-PUBLICATION.md
#    (раздел «1. Release-подпись»).
# 2. Скопируйте этот файл рядом, под именем keystore.properties
#    (без .example) — он уже в .gitignore и в репозиторий не попадёт.
# 3. Впишите свои реальные значения ниже.
#
# storeFile — путь к файлу ключа ОТНОСИТЕЛЬНО папки android/
#             (например, если положили ключ в android/app/upset-release.keystore,
#             укажите app/upset-release.keystore)
storeFile=app/upset-release.keystore
storePassword=ВАШ_ПАРОЛЬ_ОТ_ХРАНИЛИЩА
keyAlias=upset-key
keyPassword=ВАШ_ПАРОЛЬ_ОТ_КЛЮЧА
